# Local development database (production must use PostgreSQL)
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generated by `npm run ensure-env` or: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

# Local-only flags (NEVER set these in production)
ALLOW_DEMO_CHECKOUT="true"
ALLOW_LOCAL_PLAN_UPGRADE="true"

# Stripe (required for production launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Enable Stripe Identity and subscribe this app's webhook to identity.verification_session.* events.
STRIPE_PRICE_MERCHANT=
STRIPE_PRICE_PROFESSIONAL=
# Enables Stripe Tax on the seller's connected account after its registrations are configured
STRIPE_AUTOMATIC_TAX="true"

# Authenticates the reservation cleanup scheduler
CRON_SECRET=

# Email (Resend) — welcome + password reset
# Without RESEND_API_KEY in development, emails are written to tmp/email-outbox/
RESEND_API_KEY=
EMAIL_FROM="WineBloom <onboarding@resend.dev>"

# S3/R2-compatible listing media
MEDIA_ENDPOINT=
MEDIA_REGION="auto"
MEDIA_BUCKET=
MEDIA_PUBLIC_URL=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_FORCE_PATH_STYLE="false"

# WineBloom Express (mock is the only built-in provider; enable in Admin after setup)
DELIVERY_MOCK_WEBHOOK_SECRET=
# Reserved for approved future adapters; no production courier calls are implemented.
DELIVERY_DOORDASH_ENABLED="false"
DELIVERY_UBER_DIRECT_ENABLED="false"

# Marketplace AI Assistant (optional; deterministic local fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.4"

# Seller catalog imports: production requires a malware scanner (POST bytes; {"status":"clean"}).
CATALOG_MAX_ROWS=10000
CATALOG_MAX_FILE_BYTES=10485760
CATALOG_BATCH_SIZE=25
CATALOG_SCAN_REQUIRED=false
CATALOG_SCANNER_URL=
CATALOG_SCANNER_TOKEN=
# 32 random bytes, base64. Store in your secrets manager; never NEXT_PUBLIC_*.
CATALOG_CREDENTIAL_KEY=
# Reserved connector configuration; live adapters remain unavailable until authorized and certified.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WOOCOMMERCE_CONNECT_ENABLED=false
