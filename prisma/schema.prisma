generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String    @id @default(cuid())
  name                         String?
  email                        String    @unique
  emailVerified                DateTime?
  image                        String?
  passwordHash                 String?
  role                         String    @default("BUYER")
  ageVerifiedAt                DateTime?
  ageVerificationStatus        String    @default("UNVERIFIED")
  stripeIdentityVerificationId String?   @unique
  sessionVersion               Int       @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  sellerProfile           SellerProfile?
  orders                  Order[]                  @relation("BuyerOrders")
  auditLogs               AuditLog[]
  deliveries              Delivery[]               @relation("BuyerDeliveries")
  deliveryAcknowledgments DeliveryAcknowledgment[]
  aiConversations         AIConversation[]
  listingDrafts           ListingDraft[]           @relation("SellerDraftOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SellerPlan {
  id                   String          @id @default(cuid())
  code                 String          @unique
  name                 String
  monthlyPriceCents    Int
  defaultCommissionBps Int
  stripePriceId        String?
  description          String?
  sellers              SellerProfile[]
}

model SellerProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  displayName              String
  slug                     String   @unique
  bio                      String?
  region                   String?
  country                  String   @default("DE")
  shipToCountries          String   @default("DE,AT,CH")
  stripeAccountId          String?
  stripeCustomerId         String?
  stripeOnboardingComplete Boolean  @default(false)
  planId                   String
  commissionBps            Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             SellerPlan              @relation(fields: [planId], references: [id])
  listings         Listing[]
  orders           Order[]
  subscription     Subscription?
  deliverySettings SellerDeliverySettings?
  pickupLocations  PickupLocation[]
  deliveries       Delivery[]
  deliveryQuotes   DeliveryQuote[]
  listingDrafts    ListingDraft[]
  importJobs CatalogImportJob[]
  importMappings CatalogMapping[]
  sourceConnections CatalogConnection[]
}

model Subscription {
  id                   String    @id @default(cuid())
  sellerId             String    @unique
  stripeSubscriptionId String?   @unique
  status               String    @default("ACTIVE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  listings Listing[]
}

model Region {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  country  String?
  listings Listing[]
}

model Producer {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  listings Listing[]
}

model Listing {
  id                      String   @id @default(cuid())
  sellerId                String
  categoryId              String?
  regionId                String?
  producerId              String?
  title                   String
  slug                    String   @unique
  description             String
  imported                Boolean @default(false)
  importComplianceStatus  String @default("PENDING")
  importComplianceReviewJson String?
  catalogProductJson      String @default("{}")
  sku                     String?
  gtin                    String?
  sourceUrl               String?
  importFingerprint       String?
  sourceConnectionId      String?
  externalProductId       String?
  externalVariantId       String?
  lastImportAt            DateTime?
  lastSyncAt              DateTime?
  syncStatus              String @default("DISCONNECTED")
  syncBaselineJson        String @default("{}")
  saleType                String   @default("FIXED")
  status                  String   @default("DRAFT")
  priceCents              Int
  shippingCents           Int      @default(0)
  currency                String   @default("eur")
  vintage                 Int?
  abv                     Float?
  bottleSizeMl            Int?
  condition               String?
  fillLevel               String?
  labelCondition          String?
  tastingNotes            String?
  quantity                Int      @default(1)
  containsAlcohol         Boolean  @default(true)
  ageVerificationRequired Boolean  @default(true)
  signatureRequired       Boolean  @default(true)
  fragile                 Boolean  @default(true)
  declaredValueCents      Int?
  weightGrams             Int?
  lengthCm                Float?
  widthCm                 Float?
  heightCm                Float?
  localDeliveryPermitted  Boolean  @default(false)
  specialHandling         String?
  promoRank               Int      @default(0)
  searchText              String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  seller     SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id])
  region     Region?        @relation(fields: [regionId], references: [id])
  producer   Producer?      @relation(fields: [producerId], references: [id])
  images     ListingImage[]
  orderItems OrderItem[]
  @@index([sellerId, sku])
  @@index([sellerId, gtin])
  @@index([sellerId, sourceUrl])
  @@index([sellerId, importFingerprint])
  @@index([sellerId, sourceConnectionId, externalProductId, externalVariantId])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String    @id @default(cuid())
  buyerId               String
  sellerId              String
  status                String    @default("PENDING")
  currency              String    @default("eur")
  productSubtotalCents  Int
  shippingCents         Int
  taxCents              Int       @default(0)
  buyerTotalCents       Int
  stripePaymentIntentId String?   @unique
  stripeChargeId        String?
  stripeCheckoutId      String?   @unique
  refundedCents         Int       @default(0)
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  reservationExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  buyer                   User                     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller                  SellerProfile            @relation(fields: [sellerId], references: [id])
  items                   OrderItem[]
  settlement              Settlement?
  delivery                Delivery?
  deliveryAcknowledgments DeliveryAcknowledgment[]
}

model DeliveryProviderConfig {
  id            String                 @id @default(cuid())
  code          String                 @unique
  displayName   String
  enabled       Boolean                @default(false)
  environment   String                 @default("sandbox")
  regionsCsv    String                 @default("")
  webhookSecret String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deliveries    Delivery[]
  quotes        DeliveryQuote[]
  webhookEvents DeliveryWebhookEvent[]
}

model ExpressConfiguration {
  id                  String   @id @default("global")
  enabled             Boolean  @default(false)
  alcoholEnabled      Boolean  @default(false)
  allowedCountriesCsv String   @default("")
  retentionDays       Int      @default(365)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SellerDeliverySettings {
  id                    String        @id @default(cuid())
  sellerId              String        @unique
  expressEnabled        Boolean       @default(false)
  scheduledEnabled      Boolean       @default(false)
  acceptingLocalOrders  Boolean       @default(false)
  adminApprovalStatus   String        @default("PENDING")
  alcoholApprovalStatus String        @default("NOT_APPROVED")
  timezone              String        @default("UTC")
  storeHoursJson        String?
  preparationMinutes    Int           @default(60)
  deliveryRadiusKm      Float         @default(0)
  minOrderCents         Int           @default(0)
  maxOrderCents         Int?
  eligibleCategoriesCsv String        @default("")
  automaticAcceptance   Boolean       @default(false)
  deliveryInstructions  String?
  closedUntil           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  seller                SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model PickupLocation {
  id         String          @id @default(cuid())
  sellerId   String
  label      String
  address1   String
  address2   String?
  city       String
  region     String?
  postalCode String
  country    String
  latitude   Float?
  longitude  Float?
  approved   Boolean         @default(false)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  seller     SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  quotes     DeliveryQuote[]

  @@index([sellerId, approved, active])
}

model DeliveryQuote {
  id                  String                 @id @default(cuid())
  sellerId            String
  pickupLocationId    String
  providerConfigId    String
  providerQuoteId     String
  fulfillmentType     String
  feeCents            Int
  currency            String
  pickupEta           DateTime
  deliveryEta         DateTime
  expiresAt           DateTime
  ageVerification     Boolean
  signatureRequired   Boolean
  contactlessAllowed  Boolean
  returnSupported     Boolean
  requestHash         String
  deliveryAddressJson String
  createdAt           DateTime               @default(now())
  seller              SellerProfile          @relation(fields: [sellerId], references: [id])
  pickupLocation      PickupLocation         @relation(fields: [pickupLocationId], references: [id])
  providerConfig      DeliveryProviderConfig @relation(fields: [providerConfigId], references: [id])
  delivery            Delivery?

  @@unique([providerConfigId, providerQuoteId])
  @@index([sellerId, expiresAt])
}

model Delivery {
  id                     String                  @id @default(cuid())
  orderId                String                  @unique
  sellerId               String
  buyerId                String
  pickupLocationId       String
  providerConfigId       String
  quoteId                String?                 @unique
  providerDeliveryId     String?
  fulfillmentType        String
  status                 String                  @default("awaiting_payment")
  deliveryAddressJson    String
  scheduledFor           DateTime?
  ageRestricted          Boolean                 @default(false)
  signatureRequired      Boolean                 @default(false)
  contactlessAllowed     Boolean                 @default(false)
  buyerAcknowledgedAt    DateTime?
  sellerAcceptedAt       DateTime?
  readyAt                DateTime?
  pickupEta              DateTime?
  deliveryEta            DateTime?
  trackingUrl            String?
  failureCategory        String?
  providerReason         String?
  customerExplanation    String?
  failedAt               DateTime?
  returnStatus           String?
  associatedFeesCents    Int                     @default(0)
  refundResolutionStatus String                  @default("NOT_REVIEWED")
  verificationResult     String?
  verificationProvider   String?
  verifiedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller                 SellerProfile           @relation(fields: [sellerId], references: [id])
  buyer                  User                    @relation("BuyerDeliveries", fields: [buyerId], references: [id])
  pickupLocation         PickupLocation          @relation(fields: [pickupLocationId], references: [id])
  providerConfig         DeliveryProviderConfig  @relation(fields: [providerConfigId], references: [id])
  quote                  DeliveryQuote?          @relation(fields: [quoteId], references: [id])
  history                DeliveryStatusHistory[]

  @@unique([providerConfigId, providerDeliveryId])
  @@index([sellerId, status])
  @@index([buyerId, createdAt])
}

model DeliveryStatusHistory {
  id         String   @id @default(cuid())
  deliveryId String
  fromStatus String?
  toStatus   String
  source     String
  detail     String?
  createdAt  DateTime @default(now())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

model DeliveryWebhookEvent {
  id               String                 @id @default(cuid())
  providerConfigId String
  providerEventId  String
  eventType        String
  payload          String?
  receivedAt       DateTime               @default(now())
  processedAt      DateTime?
  processingError  String?
  providerConfig   DeliveryProviderConfig @relation(fields: [providerConfigId], references: [id])

  @@unique([providerConfigId, providerEventId])
  @@index([processedAt])
}

model DeliveryAcknowledgment {
  id        String   @id @default(cuid())
  orderId   String
  buyerId   String
  kind      String
  version   String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer     User     @relation(fields: [buyerId], references: [id])

  @@unique([orderId, buyerId, kind, version])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  listingId      String
  title          String
  quantity       Int    @default(1)
  unitPriceCents Int
  shippingCents  Int    @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])
}

model Settlement {
  id                         String    @id @default(cuid())
  orderId                    String    @unique
  productSubtotalCents       Int
  shippingCents              Int
  taxCents                   Int
  commissionBps              Int
  commissionAmountCents      Int
  processorFeeEstimatedCents Int
  processorFeeActualCents    Int?
  sellerPayoutCents          Int?
  currency                   String    @default("eur")
  stripeBalanceTxId          String?
  finalizedAt                DateTime?
  refundedCommissionCents    Int       @default(0)
  createdAt                  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Durable Stripe event ledger. A unique event ID makes webhook retries idempotent.
model StripeWebhookEvent {
  id          String    @id
  type        String
  accountId   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  payload     Json?
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  queryJson String
  createdAt DateTime @default(now())
}

model ComparisonSet {
  id         String   @id @default(cuid())
  userId     String
  listingIds String
  createdAt  DateTime @default(now())
}

model EditorialPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  meta      String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  mode      String
  status    String      @default("ACTIVE")
  escalated Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  citationsJson  String?
  toolCallsJson  String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ListingDraft {
  id                   String        @id @default(cuid())
  sellerId             String
  createdById          String
  sourceName           String?
  title                String
  description          String
  category             String?
  priceCents           Int?
  currency             String        @default("eur")
  quantity             Int?
  vintage              Int?
  producer             String?
  bottleSizeMl         Int?
  importJobId          String?
  rowNumber            Int?
  rawJson              String @default("{}")
  productJson          String @default("{}")
  validationErrorsJson String @default("[]")
  duplicateDraftId     String?
  duplicateResolution String?
  approvedListingId   String?
  version              Int @default(0)
  sku                  String?
  gtin                 String?
  sourceUrl            String?
  fingerprint          String?
  connectionId         String?
  externalProductId    String?
  externalVariantId    String?
  lastImportAt         DateTime?
  importJob CatalogImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  sellerAssertionsJson String?
  missingFieldsCsv     String        @default("")
  confidence           Float         @default(0)
  duplicateListingId   String?
  status               String        @default("NEEDS_REVIEW")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdBy            User          @relation("SellerDraftOwner", fields: [createdById], references: [id])

  @@index([sellerId, status])
  @@unique([importJobId, rowNumber])
  @@index([sellerId, sku])
  @@index([sellerId, fingerprint])
  @@index([sellerId, gtin])
  @@index([sellerId, sourceUrl])
  @@index([sellerId, connectionId, externalProductId, externalVariantId])
}


model CatalogImportJob {
  id String @id @default(cuid())
  sellerId String
  sourceType String
  sourceName String
  sourceUrl String?
  status String @default("MAPPING")
  mode String @default("ONE_TIME")
  requestKey String
  mappingJson String @default("{}")
  headersJson String @default("[]")
  totalRows Int @default(0)
  processedRows Int @default(0)
  error String?
  leaseToken String?
  leaseUntil DateTime?
  authorizedById String
  authorizedAt DateTime @default(now())
  authorizationText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items ListingDraft[]
  @@unique([sellerId, requestKey])
  @@index([status, leaseUntil])
  @@index([sellerId, createdAt])
}

model CatalogMapping {
  id String @id @default(cuid())
  sellerId String
  name String
  mappingJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  @@unique([sellerId, name])
}

model CatalogConnection {
  id String @id @default(cuid())
  sellerId String
  provider String
  storeId String
  storeUrl String
  status String @default("DISCONNECTED")
  mode String @default("ONE_TIME")
  encryptedCredentials String?
  syncFieldsJson String @default("[\"price\",\"quantity\"]")
  authorizedById String
  authorizedAt DateTime @default(now())
  verifiedAt DateTime?
  revokedAt DateTime?
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  events CatalogSyncEvent[]
  @@unique([sellerId, provider, storeId])
}

model CatalogSyncEvent {
  id String @id @default(cuid())
  connectionId String
  eventKey String
  topic String
  status String @default("QUEUED")
  productJson String @default("{}")
  conflictsJson String @default("[]")
  error String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  connection CatalogConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@unique([connectionId, eventKey])
}

model CatalogRateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
