{
  "name": "winetreff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-env.cjs && node scripts/prisma-local.cjs generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/prisma-local.cjs db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/prisma-local.cjs generate && tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-local.cjs studio",
    "ensure-env": "node scripts/ensure-env.cjs",
    "postinstall": "prisma generate",
    "launch:check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1122.0",
    "@aws-sdk/s3-request-presigner": "^3.1122.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
